{
  "manifest_version": 3,
  "name": "Offer Machine · Captura Mercado Livre",
  "version": "0.3.8",
  "description": "Captura pontual e conexão com o Offer local para busca, links afiliados e atualização de produtos.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capturar ofertas para o painel"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.mercadolivre.com.br/*",
    "https://*.amazon.com.br/*",
    "https://*.shopee.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["bridge.js"]
    }
  ]
}
